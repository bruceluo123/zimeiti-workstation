# ============================================================

# ── V2 专属数据库与登录（新内容库使用）───────────────────────
# 在 Supabase 新建独立项目，运行 supabase/migrations 中的迁移。
# publishable key 可给浏览器，service_role / 社交平台 token 绝不可用 NEXT_PUBLIC_ 前缀。
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# 开发阶段设为 false 可直接浏览页面；正式启用云端读写前改为 true。
NEXT_PUBLIC_ZMT_AUTH_REQUIRED=false
# 初始管理员登录邮箱；正式开放前必须配置。
ZMT_OWNER_EMAIL=you@example.com
# 登录邮件回跳地址所在站点，正式上线时改为工作站的 HTTPS 域名。
ZMT_SITE_URL=http://localhost:3002
# X 只读令牌的服务器端加密密钥：随机生成 32 字节后转 base64。
# 本地与正式部署必须使用同一个值；切勿加 NEXT_PUBLIC_ 前缀。
X_CREDENTIAL_ENCRYPTION_KEY=
# Vercel Cron 调用入口的随机密钥；仅服务端使用。
CRON_SECRET=

# 自媒体工作站 — 环境变量配置
# 1. 复制此文件为 .env.local，填入真实值
# 2. Vercel 部署时在项目设置 → Environment Variables 中填写
# ============================================================

# ── A. 旧版 Upstash KV ──────────────────────────────────
# V2 已停止浏览器直连；旧数据仍在原实例，需显式导入后再轮换旧凭据。
# 请勿再配置 NEXT_PUBLIC_ 前缀的 KV token。

# ── B. 灵感库数据（aihot.virxact.com）────────────────────
# 无需 API Key，匿名公开访问。
# 此变量仅用于本地覆盖 API 地址（一般不需修改）
# ZMT_AIHOT_BASE=https://aihot.virxact.com

# ── C. 素材工厂（AI 图像生成）───────────────────────────
# DashScope（阿里通义万象）— 推荐，国内无网络问题
# 前往 https://dashscope.aliyun.com 获取 API Key
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx

# OpenAI DALL·E — 备用（需代理）
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx

# ── D. 本地 Obsidian 知识库（可选）────────────────────────
# 不填时默认读取 D:/wiki/个人知识库/wiki；Vercel 无法访问本地磁盘
ZMT_WIKI_ROOT=D:/wiki/个人知识库/wiki
